# --- Solana RPC / WebSocket ---
# ΜΗΝ χρησιμοποιήσεις το δωρεάν δημόσιο RPC (api.mainnet-beta.solana.com) σε production -
# έχει αυστηρά rate limits και θα σε κόβει. Για testing είναι οκ.
# Για σοβαρό testing/production πάρε δωρεάν/paid key από Helius, QuickNode ή Chainstack.
SOLANA_WSS_URL=wss://api.mainnet-beta.solana.com
SOLANA_HTTP_URL=https://api.mainnet-beta.solana.com

# --- pump.fun ---
PUMPFUN_PROGRAM_ID=6EF8rrecthR5Dkzon8Nwu78hRvfCKubJ14M5uBEwF6P

# --- Λειτουργία ---
# paper  = μόνο ανίχνευση + logging, ΔΕΝ στέλνει καμία συναλλαγή
# live   = θα ενεργοποιηθεί σε επόμενο βήμα, όταν προστεθεί το execution layer
MODE=paper

# --- Storage ---
DB_PATH=./data/detections.db
